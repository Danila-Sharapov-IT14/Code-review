/*
Дан указатель P1 на вершину непустого стека. Извлечь из стека первый (верхний)
элемент и вывести его значение D, а также адрес P2 новой вершины стека. Если после
извлечения элемента стек окажется пустым, то положить P2 = nullptr. После извлечения
элемента из стека освободить память, занимаемую этим элементом.

Для каждой динамической структуры должен быть предусмотрен стандартный набор методов -
добавления/удаления/вывода элементов.
Во всех задачах обязательно наличие дружественного интерфейса. Ввод данных с клавиатуры.

В заданиях подгруппы структура «стек» (stack) моделируется цепочкой связанных
узлов-записей типа TNode. Поле Next последнего элемента цепочки равно nullptr. Вершиной
стека (top) считается первый элемент цепочки. Для доступа к стеку используется указатель на
его вершину (для пустого стека данный указатель полагается равным nullptr). Значением
элемента стека считается значение его поля Data
*/

#include <iostream>

using namespace std;

// Класс в PascalCase
// Открывающая скобка на той же строке
class Stack {
// Приватные поля с подчёркиванием в конце
private:
    // Структура в PascalCase
    struct Node {
        int data_;
        Node* next_;
        // Открывающая скобка на той же строке
        Node(int value) : data_(value), next_(nullptr) {}
    };
    Node* top_; // вершина
    int count_;
// Сначала public, затем private
public:
    // Открывающая скобка на той же строке
    Stack() : top_(nullptr), count_(0) {}

    // Метод в PascalCase
    // Открывающая скобка на той же строке
    void Add(int value) {
        Node* newNode = new Node(value);
        newNode->next_ = top_;
        top_ = newNode;
        count_++;
    }

    // Метод в PascalCase
    // Открывающая скобка на той же строке
    void RemoveTop() {
        // Проверка на пустой стек
        if (top_ == nullptr) {
            cout << "Стек пуст" << endl;
            return;
        }
        Node* temp = top_;
        cout << "Первый элемент стека:" << endl;
        cout << top_->data_ << endl;
        // Пробелы вокруг операторов
        if (top_->next_ == nullptr) {
            top_ = nullptr;
        }
        // Открывающая скобка на той же строке
        else {
            top_ = top_->next_;
        }
        cout << "Адрес новой вершины после извлечения 1 элемента: " << top_ << endl; // Вывод адреса новой вершины
        // Пробелы вокруг операторов
        if (top_ != nullptr) {
            cout << "Значение новой вершины: " << top_->data_ << endl; // Вывод значения новой вершины
        }
        delete temp;
        count_--;
    }

    // Метод в PascalCase
    // Открывающая скобка на той же строке
    void Show() {
        Node* temp = top_;
        // Пробелы вокруг операторов
        while (temp != nullptr) {
            cout << temp->data_ << endl;
            temp = temp->next_;
        }
    }
};

// Открывающая скобка на той же строке
int main() {
    // Переменная в camelCase
    Stack stack;
    setlocale(LC_ALL, "RU");
    cout << "Введите количество элементов стека" << endl;
    int n;
    cin >> n; // размер стека
    // Открывающая скобка на той же строке
    for (int i = 0; i < n; i++) {
        int num;
        cout << "Введите элемент стека" << endl;
        cin >> num;
        stack.Add(num);
    }
    cout << "Стек:" << endl;
    stack.Show();
    stack.RemoveTop();
    return 0;
}
