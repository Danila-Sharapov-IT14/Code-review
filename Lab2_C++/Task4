/*
Дан циклический двусвязный линейный список и указатель первый
элемент этого списка. Необходимо удалить в списке все элементы, у которых правый и
левый сосед совпадают. Если таких элементов нет, то оставить список без изменений.
Первый и последний элементы считать соседями. В результате вернуть ссылку на
последний элемент полученного списка.
Все динамические структуры данных реализовывать через классы. Не использовать STL.
Для каждой динамической структуры должен быть предусмотрен стандартный
набор методов - добавления/удаления/вывода элементов. Во всех задачах обязательно наличие
дружественного интерфейса. Ввод данных с клавиатуры.
*/

#include <iostream>

using namespace std;

// Класс в PascalCase
// Открывающая скобка на той же строке
class Node {
// Приватные поля с подчёркиванием в конце
private:
    int data_;
    Node* next_;
    Node* prev_;

// Сначала public, затем private
public:
    // Открывающая скобка на той же строке
    Node(int value) : data_(value), next_(nullptr), prev_(nullptr) {}

    // Дружественный интерфейс
    friend class DoubleList;
};

// Класс в PascalCase
// Открывающая скобка на той же строке
class DoubleList {
// Приватные поля с подчёркиванием в конце
private:
    Node* head_;

// Сначала public, затем private
public:
    // Открывающая скобка на той же строке
    DoubleList() : head_(nullptr) {}

    // Открывающая скобка на той же строке
    ~DoubleList() {
        // Пробелы вокруг операторов
        if (!head_) {
            return;
        }
        Node* current = head_;
        // Открывающая скобка на той же строке
        while (true) {
            Node* temp = current;
            current = current->next_;
            delete temp;
            // Пробелы вокруг операторов
            if (current == head_) {
                break;
            }
        }
    }

    // Метод в PascalCase
    // Открывающая скобка на той же строке
    void PushBack(int value) {
        Node* newNode = new Node(value);
        // Пробелы вокруг операторов
        if (!head_) {
            head_ = newNode;
            newNode->next_ = newNode;
            newNode->prev_ = newNode;
        }
        // Открывающая скобка на той же строке
        else {
            Node* tail = head_->prev_;
            tail->next_ = newNode;
            newNode->prev_ = tail;
            newNode->next_ = head_;
            head_->prev_ = newNode;
        }
    }

    // Метод в PascalCase
    // Открывающая скобка на той же строке
    void PrintList() {
        Node* current = head_;
        // Открывающая скобка на той же строке
        while (true) {
            cout << current->data_ << " ";
            current = current->next_;
            // Пробелы вокруг операторов
            if (current == head_) {
                break;
            }
        }
        cout << endl;
    }

    // Метод в PascalCase
    // Открывающая скобка на той же строке
    Node* DeleteNode(Node* node) {
        // Пробелы вокруг операторов
        if (!node) {
            return nullptr;
        }
        // Пробелы вокруг операторов
        if (node->next_ == node && node->prev_ == node) {
            // Пробелы вокруг операторов
            if (node == head_) {
                head_ = nullptr;
            }
            delete node;
            return nullptr;
        }
        Node* nextNode = node->next_;
        node->prev_->next_ = node->next_;
        node->next_->prev_ = node->prev_;
        // Пробелы вокруг операторов
        if (node == head_) {
            head_ = nextNode;
        }
        delete node;
        return nextNode;
    }

    // Метод в PascalCase
    // Открывающая скобка на той же строке
    Node* RemoveSides() {
        // Пробелы вокруг операторов
        if (!head_) {
            return nullptr;
        }
        bool anyDeletion = false;
        bool deletedSomething = false;
        // Открывающая скобка на той же строке
        while (true) {
            anyDeletion = false;
            // Пробелы вокруг операторов
            if (!head_ || head_->next_ == head_) {
                break;
            }
            Node* start = head_;
            Node* current = head_;
            bool completedCycle = false;
            // Открывающая скобка на той же строке
            while (!completedCycle) {
                int leftData = current->prev_->data_;
                int rightData = current->next_->data_;
                // Пробелы вокруг операторов
                if (leftData == rightData) {
                    anyDeletion = true;
                    deletedSomething = true;
                    Node* nextNode = current->next_;
                    // Пробелы вокруг операторов
                    if (current == head_) {
                        head_ = nextNode;
                    }
                    current = DeleteNode(current);
                    // Пробелы вокруг операторов
                    if (!current) {
                        return nullptr;
                    }
                    start = head_;
                    continue;
                }
                // Открывающая скобка на той же строке
                else {
                    current = current->next_;
                }
                // Пробелы вокруг операторов
                if (current == start) {
                    completedCycle = true;
                }
            }
            // Пробелы вокруг операторов
            if (!anyDeletion) {
                break;
            }
        }
        // Пробелы вокруг операторов
        if (!head_) {
            return nullptr;
        }
        Node* tail = head_->prev_;
        return tail;
    }

    // Дружественный интерфейс
    friend void ProcessList(DoubleList& list);
};

// Функция в PascalCase
// Открывающая скобка на той же строке
void ProcessList(DoubleList& list) {
    list.PrintList();
}

// Открывающая скобка на той же строке
int main() {
    setlocale(LC_ALL, "Russian");
    // Переменная в camelCase
    DoubleList list;
    int n, value;
    cout << "сколько надо чисел: ";
    cin >> n;
    cout << "вводи числа" << endl;
    // Открывающая скобка на той же строке
    for (int i = 0; i < n; i++) {
        cin >> value;
        list.PushBack(value);
    }
    cout << "нормальный список: ";
    list.PrintList();
    DoubleList::Node* tail = list.RemoveSides();
    cout << "обработанный список: ";
    list.PrintList();
    // Пробелы вокруг операторов
    if (tail != nullptr) {
        cout << "последний элемент: " << tail->data_ << endl;
    }
    // Открывающая скобка на той же строке
    else {
        cout << "список пуст" << endl;
    }
    return 0;
}
