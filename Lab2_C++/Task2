/* Дан набор из 10 чисел. Создать две очереди: первая должна содержать числа из
исходного набора с нечетными номерами (1, 3, …, 9), а вторая — с четными (2, 4, …, 10);
порядок чисел в каждой очереди должен совпадать с порядком чисел в исходном наборе.
Вывести указатели на начало и конец первой, а затем второй очереди.

Для каждой динамической структуры должен быть предусмотрен стандартный набор методов -
добавления/удаления/вывода элементов.
Во всех задачах обязательно наличие дружественного интерса. Ввод данных с клавиатуры.

В заданиях данной подгруппы структура «очередь» (queue) моделируется цепочкой связанных
узлов-записей типа TNode. Поле Next последнего элемента цепочки равно nullptr. Началом
очереди («головой», head) считается первый элемент цепочки, концом («хвостом», tail) — ее
последний элемент. Для возможности быстрого добавления в конец очереди нового элемента
удобно хранить, помимо указателя на начало очереди, также и указатель на ее конец. В случае
пустой очереди указатели на ее начало и конец полагаются равными nullptr. Как и для стека,
значением элемента очереди считается значение его поля Data.
*/

#include <iostream>
#include <windows.h>

using namespace std;

// Класс в PascalCase
// Открывающая скобка на той же строке
class Node {
// Приватные поля с подчёркиванием в конце
private:
    int data_;
    Node* next_;

// Сначала public, затем private
public:
    // Открывающая скобка на той же строке
    Node(int value) : data_(value), next_(nullptr) {}

    // Дружественный интерфейс
    friend class Queue;
};

// Класс в PascalCase
// Открывающая скобка на той же строке
class Queue {
// Приватные поля с подчёркиванием в конце
private:
    Node* head_;
    Node* tail_;

// Сначала public, затем private
public:
    // Открывающая скобка на той же строке
    Queue() : head_(nullptr), tail_(nullptr) {}

    // Метод в PascalCase
    // Открывающая скобка на той же строке
    void Add(int value) {
        Node* newNode = new Node(value);
        // Пробелы вокруг операторов
        if (head_ == nullptr) {
            head_ = newNode;
            tail_ = newNode;
        }
        // Открывающая скобка на той же строке
        else {
            tail_->next_ = newNode;
            tail_ = newNode;
        }
    }

    // Метод в PascalCase
    // Открывающая скобка на той же строке
    void Remove() {
        // Пробелы вокруг операторов
        if (head_ == nullptr) {
            cout << "Очередь пуста!" << endl;
            return;
        }

        Node* temp = head_;
        head_ = head_->next_;
        delete temp;

        // Пробелы вокруг операторов
        if (head_ == nullptr) {
            tail_ = nullptr;
        }
    }

    // Метод в PascalCase
    // Открывающая скобка на той же строке
    void Print() {
        Node* current = head_;
        // Пробелы вокруг операторов
        while (current != nullptr) {
            cout << current->data_ << " ";
            current = current->next_;
        }
        cout << endl;
    }

    // Метод в PascalCase
    // Открывающая скобка на той же строке
    void PrintPointers() {
        cout << "Адрес начала: " << head_;
        // Пробелы вокруг операторов
        if (head_ != nullptr) {
            cout << " (значение: " << head_->data_ << ")";
        }
        cout << endl;

        cout << "Адрес конца:  " << tail_;
        // Пробелы вокруг операторов
        if (tail_ != nullptr) {
            cout << " (значение: " << tail_->data_ << ")";
        }
        cout << endl;
    }

    // Дружественный интерфейс
    friend void PrintQueues(Queue& queue1, Queue& queue2);
};

// Функция в PascalCase
// Открывающая скобка на той же строке
void PrintQueues(Queue& queue1, Queue& queue2) {
    cout << "\nНечетная очередь:\n";
    queue1.Print();
    queue1.PrintPointers();

    cout << "\nЧетная очередь:\n";
    queue2.Print();
    queue2.PrintPointers();
}

// Открывающая скобка на той же строке
int main() {
    setlocale(LC_ALL, "Russian");

    // Переменные в camelCase
    Queue queue1, queue2;

    cout << "Введите 10 чисел:\n";
    // Открывающая скобка на той же строке
    for (int i = 1; i <= 10; i++) {
        int value;
        cout << "Число " << i << ": ";
        cin >> value;

        // Примитивная проверка на ввод
        // Пробелы вокруг операторов
        if (cin.fail()) {
            cout << "Ошибка! Введите число!\n";
            return 0;
        }

        // Распределение по очередям
        // Пробелы вокруг операторов
        if (i % 2 != 0) {
            queue1.Add(value);
        }
        // Открывающая скобка на той же строке
        else {
            queue2.Add(value);
        }
    }

    // Вывод результатов
    PrintQueues(queue1, queue2);

    return 0;
}
