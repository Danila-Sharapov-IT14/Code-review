/* Дан текстовый файл, в первой строке которого хранится число N, а во второй
строке N целых чисел. Необходимо создать упорядоченный по убыванию список, в который
поместить все эти элементы, при этом очередной элемент вставлять в список так, чтобы не
нарушалась его упорядоченность.

Для каждой динамической структуры должен быть предусмотрен стандартный набор методов -
добавления/удаления/вывода элементов.
Во всех задачах обязательно наличие дружественного интерфейса. Ввод данных с клавиатуры.
*/

#include <iostream>
#include <fstream>

using namespace std;

// Класс в PascalCase
// Открывающая скобка на той же строке
class Node {
// Приватные поля с подчёркиванием в конце
private:
    int data_;
    Node* next_;

// Сначала public, затем private
public:
    // Открывающая скобка на той же строке
    Node(int value) : data_(value), next_(nullptr) {}

    // Дружественный интерфейс
    friend class LinkedList;
};

// Класс в PascalCase
// Открывающая скобка на той же строке
class LinkedList {
// Приватные поля с подчёркиванием в конце
private:
    Node* head_;

// Сначала public, затем private
public:
    // Открывающая скобка на той же строке
    LinkedList() : head_(nullptr) {}

    // Метод в PascalCase
    // Открывающая скобка на той же строке
    void InsertSorted(int value) {
        Node* newNode = new Node(value);
        // Пробелы вокруг операторов
        if (head_ == nullptr || head_->data_ < value) {
            newNode->next_ = head_;
            head_ = newNode;
        }
        // Открывающая скобка на той же строке
        else {
            Node* current = head_;
            // Пробелы вокруг операторов
            while (current->next_ != nullptr && current->next_->data_ > value) {
                current = current->next_;
            }
            newNode->next_ = current->next_;
            current->next_ = newNode;
        }
    }

    // Метод в PascalCase
    // Открывающая скобка на той же строке
    void Print() {
        Node* current = head_;
        // Пробелы вокруг операторов
        while (current != nullptr) {
            cout << current->data_ << " ";
            current = current->next_;
        }
        cout << endl;
    }

    // Метод в PascalCase
    // Открывающая скобка на той же строке
    void ReadFromFile(const string& filename) {
        ifstream file(filename);
        // Пробелы вокруг операторов
        if (!file.is_open()) {
            cerr << "Ошибка открытия файла!" << endl;
            return;
        }

        int n;
        file >> n;

        int value;
        // Открывающая скобка на той же строке
        for (int i = 0; i < n; ++i) {
            file >> value;
            InsertSorted(value);
        }

        file.close();
    }

    // Дружественный интерфейс
    friend void ReadFromFile(LinkedList& list, const string& filename);
};

// Функция в PascalCase
// Открывающая скобка на той же строке
void ReadFromFile(LinkedList& list, const string& filename) {
    list.ReadFromFile(filename);
}

// Открывающая скобка на той же строке
int main() {
    // Переменная в camelCase
    LinkedList list;
    string filename;

    cout << "Введите имя файла: ";
    cin >> filename;

    ReadFromFile(list, filename);

    cout << "Упорядоченный список: ";
    list.Print();

    return 0;
}
