/*
Дан односвязный линейный список и указатель на голову списка P1. Необходимо
вставить значение M перед каждым вторым элементом списка, и вывести ссылку на последний
элемент полученного списка P2. При нечетном числе элементов исходного списка в конец
списка вставлять не надо.

Для каждой динамической структуры должен быть предусмотрен стандартный набор методов -
добавления/удаления/вывода элементов.
Во всех задачах обязательно наличие дружественного интерфейса. Ввод данных с клавиатуры.
*/

#include <iostream>

using namespace std;

// Класс в PascalCase
// Открывающая скобка на той же строке
class Node {
// Приватные поля с подчёркиванием в конце
private:
    int data_;
    Node* next_;

// Сначала public, затем private
public:
    // Открывающая скобка на той же строке
    Node(int value) : data_(value), next_(nullptr) {}

    // Дружественный интерфейс
    friend class LinkedList;
};

// Класс в PascalCase
// Открывающая скобка на той же строке
class LinkedList {
// Приватные поля с подчёркиванием в конце
private:
    Node* head_;

// Сначала public, затем private
public:
    // Открывающая скобка на той же строке
    LinkedList() : head_(nullptr) {}

    // Метод в PascalCase
    // Открывающая скобка на той же строке
    void Add(int value) {
        Node* newNode = new Node(value);
        // Пробелы вокруг операторов
        if (head_ == nullptr) {
            head_ = newNode;
        }
        // Открывающая скобка на той же строке
        else {
            Node* current = head_;
            // Пробелы вокруг операторов
            while (current->next_ != nullptr) {
                current = current->next_;
            }
            current->next_ = newNode;
        }
    }

    // Метод в PascalCase
    // Открывающая скобка на той же строке
    void InsertBeforeEverySecond(int value) {
        Node* current = head_;
        int count = 1;

        // Пробелы вокруг операторов
        while (current != nullptr && current->next_ != nullptr) {
            // Пробелы вокруг операторов
            if (count % 2 == 1) {
                Node* newNode = new Node(value);
                newNode->next_ = current->next_;
                current->next_ = newNode;
                current = newNode->next_;
            }
            // Открывающая скобка на той же строке
            else {
                current = current->next_;
            }
            count++;
        }
    }

    // Метод в PascalCase
    // Открывающая скобка на той же строке
    void Print() {
        Node* current = head_;
        // Пробелы вокруг операторов
        while (current != nullptr) {
            cout << current->data_ << " ";
            current = current->next_;
        }
        cout << endl;
    }

    // Метод в PascalCase
    // Открывающая скобка на той же строке
    Node* GetLastNode() {
        Node* current = head_;
        // Пробелы вокруг операторов
        while (current != nullptr && current->next_ != nullptr) {
            current = current->next_;
        }
        return current;
    }

    // Метод в PascalCase
    // Открывающая скобка на той же строке
    void ClearList() {
        // Пробелы вокруг операторов
        while (head_ != nullptr) {
            Node* temp = head_;
            head_ = head_->next_;
            delete temp;
        }
        cout << "Список очищен." << endl;
    }

    // Дружественный интерфейс
    friend void InsertBeforeEverySecond(LinkedList& list, int value);
};

// Функция в PascalCase
// Открывающая скобка на той же строке
void InsertBeforeEverySecond(LinkedList& list, int value) {
    list.InsertBeforeEverySecond(value);
}

// Открывающая скобка на той же строке
int main() {
    // Переменная в camelCase
    LinkedList list;
    int n, value, m;

    cout << "Введите количество элементов в списке: ";
    cin >> n;
    cout << "Введите элементы списка: ";
    // Открывающая скобка на той же строке
    for (int i = 0; i < n; ++i) {
        cin >> value;
        list.Add(value);
    }

    cout << "Введите значение M для вставки: ";
    cin >> m;

    // Вставка значения M перед каждым вторым элементом
    InsertBeforeEverySecond(list, m);

    cout << "Список после вставки: ";
    list.Print();

    // Получение указателя на последний элемент списка
    Node* lastNode = list.GetLastNode();

    // Вывод результата
    // Пробелы вокруг операторов
    if (lastNode != nullptr) {
        cout << "Указатель на последний элемент списка: " << lastNode << endl;
        cout << "Значение последнего элемента: " << lastNode->data_ << endl;
    }
    // Открывающая скобка на той же строке
    else {
        cout << "Список пуст." << endl;
    }
    list.ClearList();

    // Проверка, что список пуст
    cout << "Проверка списка после очистки: ";
    list.Print();

    return 0;
}
