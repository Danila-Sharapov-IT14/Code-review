import secrets
import string


LEVELS = {
    1: {
        "name": "Лёгкий",
        "length": 8,
        "groups": [string.ascii_lowercase],
    },
    2: {
        "name": "Средний",
        "length": 12,
        "groups": [string.ascii_lowercase, string.ascii_uppercase,
                   string.digits],
    },
    3: {
        "name": "Сложный",
        "length": 16,
        "groups": [string.ascii_lowercase, string.ascii_uppercase,
                   string.digits, string.punctuation],
    },
}


def generate_password(length, groups):
    alphabet = ''.join(groups)
    password_chars = [secrets.choice(group) for group in groups]
    remaining = length - len(password_chars)
    password_chars += [secrets.choice(alphabet) for _ in range(remaining)]
    secrets.SystemRandom().shuffle(password_chars)
    return ''.join(password_chars)


def choose_level():
    print("Уровни сложности пароля:")
    for key, info in LEVELS.items():
        print(f"  {key}. {info['name']} — {info['length']} символов")

    while True:
        try:
            level = int(input("Выберите уровень (1-3): "))
            if level in LEVELS:
                return level
            print("Уровень должен быть от 1 до 3")
        except ValueError:
            print("Пожалуйста, введите число")


def main():
    level = choose_level()
    info = LEVELS[level]
    password = generate_password(info["length"], info["groups"])
    print(f"Пароль ({info['name']}): {password}")


if __name__ == '__main__':
    main()
