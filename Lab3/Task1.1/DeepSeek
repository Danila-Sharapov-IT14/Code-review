import random
import string

LEVELS = {
    '1': ('Лёгкий', 8, string.ascii_lowercase),
    '2': ('Средний', 12, string.ascii_letters + string.digits),
    '3': ('Сложный', 16,
          string.ascii_letters + string.digits + string.punctuation),
}


def generate_password(length, alphabet):
    return ''.join(random.choice(alphabet) for _ in range(length))


def main():
    print("Уровни сложности:")
    for key, (name, length, _) in LEVELS.items():
        print(f"{key}. {name} ({length} символов)")

    level = input("Выберите уровень сложности (1-3): ")

    if level not in LEVELS:
        print("Неверный уровень")
        return

    name, length, alphabet = LEVELS[level]
    password = generate_password(length, alphabet)
    print(f"Пароль ({name}): {password}")


if __name__ == '__main__':
    main()
