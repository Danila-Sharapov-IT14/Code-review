"""
Для решения использовать классы, обязательно наличие конструктора(ов),
для вывода информации переопределить метод __str__()
1. Имеется набор геометрических фигур разного цвета. Среди фигур могут
встречаться круги, квадраты и отрезки. Для каждой фигуры известно, какого
она цвета. Кроме того, для круга известен его радиус (тип int), для квадрата
– размер стороны (тип int), для отрезка – длина (тип float). Написать функцию,
позволяющую ввести с клавиатуры данные для одной фигуры. Используя эту
функцию, ввести сведения об N фигурах и сохранить их в бинарном файле.
Распечатать на экране содержимое данного файла в виде таблицы
"""

import pickle

# Введена константа в верхнем регистре для имени файла
FIGURES_FILENAME = 'figures.bin'


class Figure:
    # Добавлены аннотации типов
    def __init__(self, color: str) -> None:
        self.color = color

    def __str__(self) -> str:
        return f'Фигура: {self.__class__.__name__}, цвет: {self.color}'


class Circle(Figure):
    # Добавлены аннотации типов
    def __init__(self, color: str, radius: int) -> None:
        super().__init__(color)
        self.radius = radius

    def __str__(self) -> str:
        return f"{super().__str__()}, Радиус: {self.radius}"


class Square(Figure):
    # Добавлены аннотации типов
    def __init__(self, color: str, side_length: int) -> None:
        super().__init__(color)
        self.side_length = side_length

    def __str__(self) -> str:
        return f"{super().__str__()}, Длина стороны: {self.side_length}"


class Segment(Figure):
    # Добавлены аннотации типов
    def __init__(self, color: str, length: float) -> None:
        super().__init__(color)
        self.length = length

    def __str__(self) -> str:
        return f"{super().__str__()}, Длина: {self.length}"


def input_figure() -> Figure | None:
    # Добавлены аннотации типов
    figure_type = input("Введите тип фигуры (круг, квадрат, отрезок): ")
    color = input("Введите цвет фигуры: ")

    if figure_type == 'круг':
        radius = int(input("Введите радиус круга: "))
        return Circle(color, radius)
    if figure_type == 'квадрат':
        side_length = int(input("Введите длину стороны квадрата: "))
        return Square(color, side_length)
    if figure_type == 'отрезок':
        length = float(input("Введите длину отрезка: "))
        return Segment(color, length)

    print("Неизвестный тип фигуры!")
    return None


def save_figures(filename: str, figures: list[Figure]) -> None:
    # Сохранение в файл вынесено в отдельную функцию
    # Добавлены аннотации типов
    with open(filename, 'wb') as file:
        pickle.dump(figures, file)


def load_figures(filename: str) -> list[Figure]:
    # Загрузка из файла вынесена в отдельную функцию
    # Добавлены аннотации типов
    with open(filename, 'rb') as file:
        return pickle.load(file)


def print_figures(figures: list[Figure]) -> None:
    # Вывод фигур вынесен в отдельную функцию
    # Добавлены аннотации типов
    for figure in figures:
        print(figure)


def main() -> None:
    # Исполняемый код вынесен в функцию main
    figures = []
    n = int(input("Введите количество фигур для ввода: "))

    for _ in range(n):
        figure = input_figure()
        if figure:
            figures.append(figure)

    save_figures(FIGURES_FILENAME, figures)

    loaded_figures = load_figures(FIGURES_FILENAME)
    print_figures(loaded_figures)


if __name__ == '__main__':
    main()
