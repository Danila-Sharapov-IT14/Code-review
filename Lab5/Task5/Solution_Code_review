"""
Тестирующая программа по переводу слов

Читает слова из двух файлов: русские и их английские переводы
Последовательно выводит русские слова, запрашивает перевод,
сравнивает с эталоном и в конце ставит оценку
"""

# Константы имён файлов
RUSSIAN_FILENAME = "russian.txt"
ENGLISH_FILENAME = "english.txt"

# Константы сообщений
PROMPT_TEMPLATE = "{word}: "
ANSWER_CORRECT = "Верно"
ANSWER_WRONG = "Неверно"
MARK_TEMPLATE = "Оценка: {mark}"

# Константы оценивания
MAX_MARK = 5


def read_words(filename: str) -> list[str]:
    """
    Читает слова из файла построчно

    :param filename: имя файла
    :return: список слов без символов перевода строки
    """
    with open(filename, encoding="utf-8") as file:
        return [line.strip() for line in file]


def normalize(word: str) -> str:
    """
    Приводит слово к нормальному виду для сравнения

    :param word: исходное слово
    :return: слово без пробелов по краям в нижнем регистре
    """
    return word.strip().lower()


def ask_translation(russian_word: str) -> str:
    """
    Запрашивает перевод слова у пользователя

    :param russian_word: слово на русском
    :return: введённый перевод
    """
    return input(PROMPT_TEMPLATE.format(word=russian_word))


def run_test(
    russian_words: list[str], english_words: list[str]
) -> int:
    """
    Проводит тест и возвращает количество правильных ответов

    :param russian_words: список русских слов
    :param english_words: список английских переводов
    :return: число верных ответов
    """
    correct_count = 0
    total = min(len(russian_words), len(english_words))

    for i in range(total):
        russian = russian_words[i]
        answer = ask_translation(russian)

        if normalize(answer) == normalize(english_words[i]):
            print(ANSWER_CORRECT)
            correct_count += 1
        else:
            print(ANSWER_WRONG)

    return correct_count


def calc_mark(correct: int, total: int) -> int:
    """
    Вычисляет оценку по количеству правильных ответов

    :param correct: число верных ответов
    :param total: общее число вопросов
    :return: оценка от 0 до MAX_MARK
    """
    if total == 0:
        return 0
    return round(correct / total * MAX_MARK)


def main() -> None:
    """Точка входа: чтение файлов, тест, вывод оценки"""
    russian_words = read_words(RUSSIAN_FILENAME)
    english_words = read_words(ENGLISH_FILENAME)

    total = min(len(russian_words), len(english_words))
    correct = run_test(russian_words, english_words)
    mark = calc_mark(correct, total)

    print(MARK_TEMPLATE.format(mark=mark))


if __name__ == '__main__':
    main()
