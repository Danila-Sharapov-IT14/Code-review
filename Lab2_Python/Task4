"""
Дан текстовый файл в первой строке которого хранится число n,
а во второй строке n целых чисел
Необходимо создать упорядоченный по возрастанию список,
в который поместить все эти элементы, при этом очередной элемент
вставлять в список так, чтобы не нарушалась его упорядоченность
"""

# Введена константа в верхнем регистре для индекса первой строки
FIRST_LINE_INDEX = 0


class Node:
    # Добавлены аннотации типов
    def __init__(self, data: int) -> None:
        self.data = data
        self.next = None


class LinkedList:
    # Добавлены аннотации типов
    def __init__(self) -> None:
        self.head = None

    def insert_sorted(self, data: int) -> None:
        # Добавлены аннотации типов
        # Комментарии убраны из концов строк, перенесены отдельно
        # Длинное условие разбито на строки
        new_node = Node(data)
        if not self.head or self.head.data >= data:
            new_node.next = self.head
            self.head = new_node
        else:
            current = self.head
            while current.next and current.next.data < data:
                current = current.next
            new_node.next = current.next
            current.next = new_node

    def print_list(self) -> None:
        # Добавлены аннотации типов
        current = self.head
        while current:
            print(current.data, end=" ")
            current = current.next
        print()

    def get_all_elements(self) -> list[int]:
        # Добавлены аннотации типов
        elements = []
        current = self.head
        while current:
            elements.append(current.data)
            current = current.next
        return elements


def create_sorted_list_from_file(file_name: str) -> 'LinkedList | None':
    # Имя ll заменено на linked_list
    # Добавлены аннотации типов
    # Убран неиспользуемый индекс FIRST_LINE_INDEX
    linked_list = LinkedList()
    with open(file_name, 'r') as file:
        try:
            n = int(file.readline())
            numbers = list(map(int, file.readline().split()))

            if len(numbers) != n:
                print("Ошибка: В файле указано неверное количество чисел")
                return None

            for number in numbers:
                linked_list.insert_sorted(number)
        except ValueError:
            print("Ошибка: Неверный формат данных в файле")
            return None
    return linked_list


def write_sorted_list_to_file(file_name: str,
                              linked_list: LinkedList) -> None:
    # Имя ll заменено на linked_list
    # Добавлены аннотации типов
    # Длинная сигнатура перенесена через скобки
    with open(file_name, 'w') as file:
        elements = linked_list.get_all_elements()
        file.write(f"{len(elements)}\n")
        file.write(" ".join(map(str, elements)))


def main() -> None:
    # Исполняемый код вынесен в функцию main
    file_name = input("Введите имя текстового файла: ")
    sorted_list = create_sorted_list_from_file(file_name)

    if sorted_list:
        print("Упорядоченный список:")
        sorted_list.print_list()

        write_sorted_list_to_file(file_name, sorted_list)
        print(f"Сортированный список записан в файл {file_name}")
    else:
        print("Не удалось создать отсортированный список из файла")


if __name__ == '__main__':
    main()
